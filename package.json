{
  "name": "module-sdk",
  "version": "1.3.5",
  "description": "數位校園工具箱選用（外掛）功能模組 SDK：契約常數、型別快照、manifest schema、module:check 靜態掃描、影子 tsc",
  "type": "module",
  "bin": {
    "module-check": "bin/module-check.mjs",
    "module-shadow-tsc": "bin/module-shadow-tsc.mjs",
    "module-snapshot-gen": "bin/module-snapshot-gen.mjs"
  },
  "scripts": {
    "module:check": "node bin/module-check.mjs",
    "module:shadow-tsc": "node bin/module-shadow-tsc.mjs",
    "module:snapshot-gen": "node bin/module-snapshot-gen.mjs",
    "test": "node test/run-tests.mjs && node test/golden.mjs"
  },
  "files": [
    "bin",
    "src",
    "snapshots",
    "module.schema.json",
    "tsconfig.shadow.json",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "campus-toolkit",
    "module",
    "plugin",
    "sdk",
    "manifest",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takan003/module-sdk.git"
  },
  "homepage": "https://github.com/takan003/module-sdk#readme",
  "bugs": {
    "url": "https://github.com/takan003/module-sdk/issues"
  },
  "author": "takan003",
  "engines": { "node": ">=20" },
  "license": "MIT"
}
